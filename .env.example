# Neon PostgreSQL connection string.
# Add the real value only in Vercel Environment Variables.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Optional: first-time Owner login defaults. If omitted, the existing GHN defaults are used.
GHN_OWNER_EMAIL="septywanf@gmail.com"
GHN_OWNER_PASSWORD="CHANGE_ME"

# Existing AI Studio variable (kept for compatibility if used elsewhere).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
